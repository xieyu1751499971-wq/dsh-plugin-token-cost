{
  "name": "@local/dsh-plugin-token-cost",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Estimates token cost for a DeepSeek Harness session and each of its turns, priced per model and peak/off-peak period.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "token-cost",
    "pricing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xieyu1751499971-wq/dsh-plugin-token-cost.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "projection.js",
    "pricing-source.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/fold.test.mjs && node test/pricing.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
